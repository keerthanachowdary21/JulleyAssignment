# GEMINI_API_KEY: Required for Gemini AI API calls (Agentic Kanban Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing key for stateless authentication tokens.
JWT_SECRET="replace-with-strong-256-bit-secret"

# DATABASE_URL: PostgreSQL connection string (for Prisma / production deployment) or SQLite file path.
DATABASE_URL="postgresql://kanban_user:secure_password@localhost:5432/collaborative_kanban"
SQLITE_DB_PATH="./kanban.db"

