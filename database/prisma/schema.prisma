// ============================================================================
// Prisma Schema for Collaborative Multi-Tenant Kanban Board (PostgreSQL)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORG_ADMIN
  TENANT_ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  tenants     Tenant[]
  memberships Membership[]
  boards      Board[]

  @@map("organizations")
}

model Tenant {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  boards         Board[]
  columns        BoardColumn[]
  tasks          Task[]
  activityLogs   ActivityLog[]

  @@index([organizationId])
  @@map("tenants")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  email         String        @unique
  passwordHash  String        @map("password_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  memberships   Membership[]
  createdBoards Board[]       @relation("BoardCreator")
  assignedTasks Task[]        @relation("TaskAssignee")
  activityLogs  ActivityLog[]

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  tenantId       String?      @map("tenant_id") @db.Uuid
  role           Role
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([organizationId, userId])
  @@map("memberships")
}

model Board {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  name           String
  description    String        @default("")
  createdBy      String        @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator        User          @relation("BoardCreator", fields: [createdBy], references: [id])
  columns        BoardColumn[]
  tasks          Task[]

  @@index([tenantId])
  @@map("boards")
}

model BoardColumn {
  id       String @id @default(uuid()) @db.Uuid
  boardId  String @map("board_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String
  position Int
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@index([boardId])
  @@map("columns")
}

model Task {
  id          String      @id @default(uuid()) @db.Uuid
  boardId     String      @map("board_id") @db.Uuid
  columnId    String      @map("column_id") @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  title       String
  description String      @default("")
  assignedTo  String?     @map("assigned_to") @db.Uuid
  priority    Priority    @default(MEDIUM)
  dueDate     DateTime?   @map("due_date")
  labels      Json        @default("[]")
  position    Int
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  board       Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column      BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([columnId])
  @@index([tenantId, columnId, position])
  @@map("tasks")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("activity_logs")
}
